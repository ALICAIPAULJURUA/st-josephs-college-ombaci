{
  "name": "ombaci-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-tinymce-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "backup:sqlite": "node --env-file-if-exists=.env.local --import tsx scripts/backup-local-sqlite.ts",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval:chat": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate-chat.ts",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:content": "node --env-file-if-exists=.env.local --import tsx scripts/check-content.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@libsql/client": "^0.18.0",
    "@neon/config": "^1.10.0",
    "@neon/env": "^1.6.8",
    "@tinymce/tinymce-react": "^6.3.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "iron-session": "^9.0.1",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "tinymce": "^8.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.4.2"
}
