# D3 is unresolved. Replace with the production domain.
NEXT_PUBLIC_SITE_URL=https://example.com

# Leave unset for local PGlite at ./data/site.db, or set a PostgreSQL URL.
# Use Neon's pooled URL for the app; use DATABASE_URL_UNPOOLED only for migrations.
DATABASE_URL=
# Optional unpooled Neon URL used by Drizzle Kit schema generation.
DATABASE_URL_UNPOOLED=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Development-only seed account. Use a password with at least 12 characters.
# These values are rejected when NODE_ENV=production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# School WhatsApp number in international format without the plus sign.
NEXT_PUBLIC_WHATSAPP_NUMBER=256770911635

# The assistant uses OpenRouter. Keep this key server-side.
# OPEN_ROUTER_API_KEY is also accepted for existing local environment files.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Image storage: local for development, cloudinary for production.
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Private application documents go outside public/. Production requires a persistent private volume.
APPLICATION_PRIVATE_STORAGE_DIR=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# D4 is unresolved. Use the school-approved sender and admissions inbox.
EMAIL_FROM=
ADMISSIONS_EMAIL=
EMAIL_API_KEY=

PLAUSIBLE_DOMAIN=
