# D3 is unresolved. Replace with the production domain.
NEXT_PUBLIC_SITE_URL=https://example.com

# D2: Vercel plus Neon for production. SQLite is used for local development
# and CI when PAYLOAD_DATABASE=sqlite.
PAYLOAD_DATABASE=sqlite
DATABASE_URI=
SQLITE_DATABASE_URI=file:./ombaci-dev.db
PAYLOAD_SECRET=

# Local seed account. Leave blank in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# School WhatsApp number in international format without the plus sign.
NEXT_PUBLIC_WHATSAPP_NUMBER=256770911635

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Image storage: configure Cloudinary or Cloudflare R2, not both.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# D4 is unresolved. Use the school-approved sender and admissions inbox.
EMAIL_FROM=
ADMISSIONS_EMAIL=
EMAIL_API_KEY=

PLAUSIBLE_DOMAIN=
